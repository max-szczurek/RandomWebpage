{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WebsitePurpose": "A whimsical homepage for a small, imaginary neighborhood bakery. Use a random photo, and build the color scheme from its colors.",
  "Claude": {
    "FallbackModel": "claude-haiku-4-5",
    "MaxTokens": 3000,
    "MaxToolRounds": 4
  },
  "Palette": {
    "SampleCount": 8
  },
  "Images": {
    "MaxBytes": 5000000,
    "TimeoutSeconds": 10,
    "MaxPerPage": 3,
    "CacheMinutes": 60,
    "CacheMaxBytes": 50000000
  },
  "Traffic": {
    "PerIpPermitLimit": 20,
    "PerIpWindowMinutes": 10,
    "PerIpConcurrency": 2,
    "GlobalPermitLimit": 120,
    "GlobalWindowMinutes": 60
  }
}
